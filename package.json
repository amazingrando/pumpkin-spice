{
  "name": "pumpkin-spice-design-system",
  "version": "0.0.0-development",
  "private": true,
  "description": "Pumpkin Spice Design System: design tokens, React components, and Lit web components built on one shared CSS layer.",
  "keywords": [
    "design system",
    "design tokens",
    "lit",
    "react",
    "storybook",
    "tailwind",
    "web components"
  ],
  "license": "MIT",
  "homepage": "https://github.com/amazingrando/pumpkin-spice",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amazingrando/pumpkin-spice.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.13"
  },
  "workspaces": [
    "packages/tokens",
    "packages/styles",
    "packages/web-components",
    "packages/react"
  ],
  "scripts": {
    "tokens": "npm run build -w @pumpkin-spice/tokens",
    "build": "npm run build --workspaces",
    "storybook": "npm run tokens && storybook dev -p 6006",
    "storybook-build": "npm run tokens && storybook build -o .out"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.4",
    "@storybook/addon-docs": "^10.6.4",
    "@storybook/react-vite": "^10.6.4",
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
