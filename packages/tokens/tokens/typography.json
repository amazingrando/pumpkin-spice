{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"]
      },
      "serif": { "$value": ["Georgia", "Cambria", "Times New Roman", "serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "sm": { "$value": "0.875rem" },
      "md": { "$value": "1rem" },
      "lg": { "$value": "1.25rem" },
      "xl": { "$value": "1.75rem" }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.2 },
      "normal": { "$value": 1.6 }
    }
  }
}
