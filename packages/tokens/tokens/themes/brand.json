        ],
        "min": 3
      }
    },
    "input": {
      "$type": "color",
      "$value": {
        "pick": [
          "{color.brand.100}",
          "{color.brand.50}",
          "{color.white}",
          "{color.neutral.950}"
        ],
        "against": [
          "background"
        ],
        "min": 3
      }
    },
    "ring": {
      "$type": "color",
      "$value": {
        "pick": [
          "{color.white}",
          "{color.neutral.950}"
        ],
        "against": [
